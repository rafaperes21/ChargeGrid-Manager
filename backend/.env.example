DATABASE_URL=postgresql+psycopg://chargegrid:chargegrid@localhost:5432/chargegrid

# JWT
JWT_SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Google OAuth (Client ID do console do Google — usado para validar o id_token enviado
# pelo frontend no login com Google)
GOOGLE_OAUTH_CLIENT_ID=

# Origens do frontend liberadas no CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Chatbot do proprietário (M7 mínimo) — LLM local via Ollama, sem chave de API
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
IA_SERVICE_URL=http://localhost:8001

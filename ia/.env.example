DATABASE_URL=postgresql+psycopg://chargegrid:chargegrid@localhost:5432/chargegrid

# Previsao de demanda (Prophet)
FORECAST_MIN_HISTORY_DAYS=28
FORECAST_DEFAULT_HORIZON_HOURS=48
FORECAST_CACHE_TTL_SECONDS=3600

# Deteccao de anomalias
ANOMALY_DEFAULT_LOOKBACK_HOURS=168
ANOMALY_ZERO_POWER_MINUTES=30
ANOMALY_OVER_NOMINAL_TOLERANCE_PCT=0.05
ANOMALY_OFFLINE_CYCLES=3
ANOMALY_OFFLINE_CYCLE_MINUTES=15
